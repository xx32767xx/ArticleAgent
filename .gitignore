# ---- 临时文件（只存过程产物，不入库）----
temp/*
!temp/.gitkeep

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini
~$*

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- Node ----
node_modules/
dist/
build/

# ---- 本地环境与密钥 ----
.env
.env.*
!.env.example
*.secret
*.pem

# ---- 测试与覆盖率 ----
.pytest_cache/
.coverage
htmlcov/

# ---- 日志 ----
*.log
